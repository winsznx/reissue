# Copy to .env and fill in. Never commit .env.

# Reissue support services (docker compose defaults)
DATABASE_URL=postgres://reissue:reissue@127.0.0.1:5442/reissue
REDIS_URL=redis://127.0.0.1:6392
S3_ENDPOINT=http://127.0.0.1:9210
S3_BUCKET=reissue-documents
S3_ACCESS_KEY_ID=reissue
S3_SECRET_ACCESS_KEY=reissue-local-secret
WORKER_URL=http://127.0.0.1:4220

# Public URLs
REISSUE_PUBLIC_URL=http://localhost:3210
API_BASE_URL=http://localhost:4210
API_PORT=4210

# Workbench sign-in and session signing (generate: openssl rand -hex 32)
WORKBENCH_ACCESS_CODE=
APP_SESSION_SECRET=

# Switch (see switch/setup.md). Coordinator credentials are written by
# `pnpm switch:register` on first run; keep them out of git.
SWITCH_BASE_URL=
SWITCH_REGISTRATION_KEY=
SWITCH_COORDINATOR_NAME=reissue
SWITCH_COORDINATOR_AGENT_ID=
SWITCH_COORDINATOR_AGENT_API_KEY=
SWITCH_EXAMINER_NAME=reissue-examiner
SWITCH_LIAISON_NAME=reissue-liaison
SWITCH_OPS_ROOM_ID=
SWITCH_OPS_PLATFORM=slack
SWITCH_SUPPLIER_ROOM_ID=
SWITCH_SUPPLIER_PLATFORM=telegram
SWITCH_VERIFICATION_ROOM_ID=
SWITCH_VERIFICATION_PLATFORM=mattermost

# Tool tokens the Examiner and Liaison agents present to the Reissue MCP endpoint
REISSUE_EXAMINER_TOOL_TOKEN=
REISSUE_LIAISON_TOOL_TOKEN=

# Optional model assistance (extraction gap-fill, supplier reply labelling)
EXTRACTION_MODEL_PROVIDER=
EXTRACTION_MODEL=
EXTRACTION_API_KEY=
REPLY_CLASSIFIER_PROVIDER=

# Shortened reminder intervals, clearly labelled in messages
DEMO_TIMING_PROFILE=false
