    "lint": "eslint src test"
  },
  "dependencies": { "pdf-lib": "^1.17.1", "yazl": "^3.3.1", "yauzl": "^3.4.0" },
  "devDependencies": { "@types/yazl": "^3.3.0", "@types/yauzl": "^2.10.3", "typescript": "^5.8.3", "vitest": "^4.0.0" }
}
