    "@reissue/core": "workspace:*",
    "@reissue/db": "workspace:*",
    "@reissue/switch-adapter": "workspace:*",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.6.1",
    "pino": "^10.4.0",
    "zod": "^4.3.4"
  },
  "devDependencies": { "typescript": "^5.8.3", "vitest": "^4.0.0" }
