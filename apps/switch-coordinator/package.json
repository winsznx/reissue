{
  "name": "@reissue/switch-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "register": "tsx --env-file-if-exists=../../.env src/register.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "setup:local": "tsx --env-file-if-exists=../../.env src/setup-local.ts",
    "connect-rooms": "tsx --env-file-if-exists=../../.env src/connect-rooms.ts"
  },
  "dependencies": {
    "@reissue/contracts": "workspace:*",
    "@reissue/db": "workspace:*",
    "@reissue/switch-adapter": "workspace:*",
    "@reissue/workflows": "workspace:*",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
